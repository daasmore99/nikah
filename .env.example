# Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# Ambil dari Supabase: Project Settings > API (Project URL dan anon/publishable key).
# Anon key aman dipakai di browser karena semua tabel dilindungi RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk mencoba UI di laptop tanpa Supabase (data ke .local-data/db.json).
# Diabaikan di production dan kalau dua variabel Supabase di atas terisi.
# LOCAL_MODE=1
